{
  "name": "wrapline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "verify:checkout": "node scripts/verify-checkout.mjs",
    "build": "npm run lint && VITE_STUDIO_CHECKOUT_ENABLED=true vite build",
    "verify:release": "npm run verify:checkout && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.6"
  },
  "dependencies": {
    "@audio/encode-mp3": "^1.2.2"
  }
}
